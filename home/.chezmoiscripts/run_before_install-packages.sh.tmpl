{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

brewfile="$(mktemp)"
trap 'rm -f "$brewfile"' EXIT

cat > "$brewfile" <<EOF
{{ range .packages.universal.taps -}}
tap {{ . | quote | replace " " "\", \"" }}, trusted: true
{{ end -}}
{{ range .packages.universal.brews -}}
brew {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.universal.casks -}}
cask {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.universal.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}

{{- if .isWorkComputer }}
{{ range .packages.work.taps -}}
tap {{ . | quote | replace " " "\", \"" }}, trusted: true
{{ end -}}
{{ range .packages.work.brews -}}
brew {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.work.casks -}}
cask {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.work.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
{{- end }}

{{- if .isHomeComputer }}
{{ range .packages.home.taps -}}
tap {{ . | quote | replace " " "\", \"" }}, trusted: true
{{ end -}}
{{ range .packages.home.brews -}}
brew {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.home.casks -}}
cask {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range .packages.home.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
{{- end }}
EOF

# Install/upgrade everything. Don't let one self-updating cask abort the apply.
brew bundle --file="$brewfile" || bundle_failed=1

# Self-heal: apps like Chrome update themselves in place, which leaves
# Homebrew's records stale and makes the next `brew bundle` upgrade fail with
# "It seems there is already an App at ...". A forced reinstall rewrites the
# cask's install receipt (INSTALL_RECEIPT.json), so future upgrades are clean.
if [ -n "${bundle_failed:-}" ]; then
  brew bundle --file="$brewfile" --force
fi

brew bundle cleanup --force --file="$brewfile"
{{ end -}}
